# ==============================================================================
# Environment Variables — TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ==============================================================================

# --- Polluxa API ---
POLLUXA_API_BASE_URL=https://sales.polluxa.com/api
POLLUXA_API_KEY=your_api_key_here
POLLUXA_API_SECRET=your_api_secret_here

# --- LinkedIn Agent ---
LINKEDIN_ACCOUNT_AGE_TIER=1+ Year
DAILY_INVITE_LIMIT=30
DAILY_MESSAGE_LIMIT=60

# --- Database ---
DATABASE_PATH=./data/linkedin_analytics.db

# --- Pipeline ---
PIPELINE_BATCH_SIZE=100
PIPELINE_MAX_RETRIES=3
PIPELINE_RETRY_BACKOFF_BASE=2
PIPELINE_RATE_LIMIT_REQUESTS_PER_MINUTE=30

# --- Data Quality ---
DQ_PASS_THRESHOLD=0.85
DQ_ALERT_ON_FAIL=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/pipeline.log

# --- Alerting ---
ALERT_EMAIL=your_email@example.com
ALERT_ON_PIPELINE_FAILURE=true
ALERT_ON_DQ_BREACH=true
ALERT_ON_ANOMALOUS_DURATION=true
